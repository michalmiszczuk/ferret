{
  "name": "review-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "review-app": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "tsx watch src/cli/index.ts start",
