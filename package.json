{
  "name": "review-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local triage desk for AI code reviews",
  "main": "dist/desktop/main.cjs",
  "type": "module",
  "bin": {
    "review-app": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "tsx watch src/cli/index.ts start",
    "dev:ui": "vite",
    "build": "vite build && tsup",
    "start": "node dist/cli.js start",
    "seed": "tsx scripts/seed.ts",
    "icon": "tsx scripts/make-icon.ts",
    "logo": "node scripts/run-electron.mjs scripts/import-logo.cjs",
    "desktop:dev": "npm run build && node scripts/run-electron.mjs .",
    "desktop:dist": "npm run build && electron-builder --win",
    "screenshot": "node scripts/run-electron.mjs scripts/screenshot.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "shiki": "^1.29.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
